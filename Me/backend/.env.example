# Copy to backend/.env and adjust. Never commit real secrets.

ENV=local
LOG_LEVEL=INFO

# --- Internal JWT (HS256) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-in-prod
JWT_ALG=HS256

# --- Postgres (FHIR response cache) ---
POSTGRES_USER=medicore
POSTGRES_PASSWORD=medicore_pw
POSTGRES_DB=medicore
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional: overrides the values above when set
# DATABASE_URL=postgresql://medicore:medicore_pw@postgres:5432/medicore

# --- MongoDB (triage queue) ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=medicore

# --- Redis / Kafka ---
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BROKERS=kafka:9092

# --- FHIR (Epic/Cerner) ---
FHIR_BASE_URL=https://example-fhir-server/fhir
FHIR_OAUTH_TOKEN_URL=https://example-fhir-server/oauth2/token
FHIR_CLIENT_ID=replace-me
FHIR_CLIENT_SECRET=replace-me
FHIR_TIMEOUT_SECONDS=10

# --- OIDC SSO ---
# Bare issuer or full discovery URL, both accepted.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8081/oidc/callback
# Preferred for RS256 verification; derived from OIDC_ISSUER when empty.
OIDC_JWKS_URI=
# Leave empty to skip aud/iss claim validation (recommended to set in prod).
OIDC_AUDIENCE=
OIDC_ISSUER_CLAIM=

# Session cookie signing key: openssl rand -hex 32
SESSION_SECRET=dev-change-me

# Comma-separated. Must not be "*" when credentials are allowed.
ALLOWED_ORIGINS=http://localhost:5173

# --- Local demo login (disabled outside local/test) ---
DEMO_PASSWORD=medicore-dev

# --- Observability ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAMESPACE=medicore
