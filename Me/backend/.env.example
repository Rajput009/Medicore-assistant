# Copy to backend/.env and adjust. Never commit real secrets.

ENV=local
LOG_LEVEL=INFO

# --- Internal JWT (HS256) ---
# Generate with: openssl rand -hex 32
# In production (ENV not local/test/dev) the service REFUSES TO START if this
# is a placeholder or shorter than 32 characters. That is deliberate: booting
# with the published default lets anyone mint a valid admin token.
JWT_SECRET=change-this-in-prod
JWT_ALG=HS256
# Access-token lifetime in minutes (1..60 in production). Default 15.
ACCESS_TOKEN_TTL_MINUTES=15

# --- Postgres (FHIR response cache) ---
POSTGRES_USER=medicore
POSTGRES_PASSWORD=medicore_pw
POSTGRES_DB=medicore
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional: overrides the values above when set
# DATABASE_URL=postgresql://medicore:medicore_pw@postgres:5432/medicore

# --- MongoDB (triage queue) ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=medicore

# --- Redis / Kafka ---
# REDIS_ENABLED=true shares rate-limit budgets and the token denylist across
# replicas. Leave false for single-process local runs without Redis.
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
KAFKA_BROKERS=kafka:9092

# httpOnly session cookie issued on login/OIDC callback. The SPA never needs
# to hold the JWT in JavaScript-accessible storage when cookies are enabled.
AUTH_SET_COOKIE=true
AUTH_COOKIE_NAME=medicore_session

# --- FHIR (Epic/Cerner) ---
FHIR_BASE_URL=https://example-fhir-server/fhir
FHIR_OAUTH_TOKEN_URL=https://example-fhir-server/oauth2/token
FHIR_CLIENT_ID=replace-me
FHIR_CLIENT_SECRET=replace-me
FHIR_TIMEOUT_SECONDS=10

# --- OIDC SSO ---
# Bare issuer or full discovery URL, both accepted.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8081/oidc/callback
# Preferred for RS256 verification; derived from OIDC_ISSUER when empty.
OIDC_JWKS_URI=
# Leave empty to skip aud/iss claim validation (recommended to set in prod).
OIDC_AUDIENCE=
OIDC_ISSUER_CLAIM=

# Session cookie signing key: openssl rand -hex 32
SESSION_SECRET=dev-change-me

# Comma-separated. Must not be "*" when credentials are allowed.
ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated Host header allow-list. Required when ENV=production.
# Example: api.hospital.example,localhost
TRUSTED_HOSTS=
# Interactive OpenAPI docs (/docs, /redoc). Forced off in production.
EXPOSE_API_DOCS=false

# --- Local demo login ---
# Forced OFF in production. Outside production it is on for ENV=local/test
# and otherwise requires ENABLE_DEMO_LOGIN=true.
ENABLE_DEMO_LOGIN=false
DEMO_PASSWORD=medicore-dev

# --- Observability ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAMESPACE=medicore

# --- Abuse protection ---
RATE_LIMIT_PER_MINUTE=120
# Login is the credential-stuffing target, so it gets a tighter budget.
LOGIN_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=1048576
ENABLE_HSTS=true

# --- Audit trail (HIPAA 164.312(b)) ---
# Patient identifiers in audit records are pseudonymised by default, so the log
# stream can be shipped off-site without carrying raw PHI. Enable raw ids only
# when the sink is itself an access-controlled, HIPAA-compliant store.
AUDIT_LOG_RAW_IDENTIFIERS=false
# Dedicated salt for pseudonymisation; falls back to JWT_SECRET when unset.
# Changing it breaks correlation with previously written audit records.
AUDIT_LOG_SALT=
