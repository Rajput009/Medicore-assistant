# ⚠️  THIS FILE IS NOT RUNNING. It is an example, not an installed workflow.
#
# Until it is copied to .github/workflows/ci.yml, no gate in this repository
# is enforced on push or pull request: `gh pr checks` reports "no checks
# reported", and every "all green" claim rests on someone having run the
# suite locally. Agents and CI apps cannot install it themselves — pushing a
# file under .github/workflows/ requires the "workflows" token scope.
#
# To turn it on (one commit, from a normal user account):
#
#     git mv .github/ci.yml.example .github/workflows/ci.yml
#     git commit -m "Enable CI" && git push
#
# Until then, `cd Me && make verify` runs the same eight gates locally and is
# the only reproducible check available.
#
name: CI

on:
  push:
    branches: ["**"]
  pull_request:

defaults:
  run:
    working-directory: Me

jobs:
  backend:
    name: Backend (lint + audit + tests)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install ruff pytest pytest-asyncio pip-audit \
            fastapi "uvicorn[standard]" "pydantic>=2" pydantic-settings \
            "python-jose[cryptography]" httpx asyncpg pymongo motor authlib \
            itsdangerous python-multipart redis \
            pgserver mongomock-motor fakeredis pyyaml

      - name: Lint
        run: ruff check backend

      - name: Dependency audit
        # Blocking. Exceptions live in scripts/audit_python.sh with a written
        # reason and a guard test, so an accepted risk cannot become a
        # forgotten one.
        run: bash scripts/audit_python.sh

      - name: Test
        env:
          ENV: test
          OTEL_ENABLED: "false"
          JWT_SECRET: "test-secret-at-least-32-chars-long!!"
          REDIS_ENABLED: "false"
        run: pytest backend/tests -q --tb=line

  frontend:
    name: Frontend (typecheck + audit + tests + build)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: Me/frontend/web/package-lock.json

      - name: Install
        working-directory: Me/frontend/web
        run: npm ci --no-audit --no-fund || npm install --no-audit --no-fund

      - name: Dependency audit
        # Blocking for *runtime* dependencies only; dev-tool advisories are
        # printed but do not fail the build (vite/esbuild never ship to a
        # browser). Exceptions are documented in scripts/audit_node.sh.
        run: bash scripts/audit_node.sh

      - name: Typecheck (app)
        working-directory: Me/frontend/web
        run: npx tsc --noEmit

      - name: Typecheck (e2e specs)
        working-directory: Me/frontend/web
        run: npx tsc --noEmit -p tsconfig.e2e.json

      - name: Unit + integration tests
        working-directory: Me/frontend/web
        run: npm test -- --run

      - name: Build
        working-directory: Me/frontend/web
        run: npm run build

  e2e:
    name: Browser end-to-end (stubbed)
    runs-on: ubuntu-latest
    needs: [frontend]
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: Me/frontend/web/package-lock.json

      - name: Install
        working-directory: Me/frontend/web
        run: npm ci --no-audit --no-fund || npm install --no-audit --no-fund

      - name: Install Playwright browsers
        working-directory: Me/frontend/web
        run: npx playwright install --with-deps chromium

      - name: Run end-to-end tests
        working-directory: Me/frontend/web
        run: npx playwright test --project=chromium

      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: playwright-report
          path: Me/frontend/web/playwright-report/
          retention-days: 7

  compose:
    name: Validate docker-compose
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate compose file
        run: docker compose -f deploy/docker/docker-compose.yml config --quiet
